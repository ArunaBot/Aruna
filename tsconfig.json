{
  "allowSyntheticDefaultImports": true,
  "include": ["src/**/*"],
  "compilerOptions": {
    "strict": true,
    "lib": ["ES6", "DOM", "ES2015", "ES2017", "ES2018", "ES2019", "ES2020", "ES2021", "ESNext"],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "removeComments": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "target": "ES6",
    "module": "CommonJS",
    "outDir": "build/aruna",
    "types": ["node", "discord.js"],
    "noImplicitAny": true
  },
  "exclude": ["node_modules", "src/tests", "src/scripts"]
}
